{
  "name": "@alinha/keycloak-theme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc --noEmit && vite build",
    "build-keycloak-theme": "pnpm build && keycloakify build",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@alinha/ui": "workspace:*",
    "@tsparticles/engine": "4.4.0",
    "@tsparticles/react": "4.4.0",
    "@tsparticles/slim": "4.4.0",
    "keycloakify": "^11.16.4",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
