# Dev-only defaults for deploy/docker-compose.dev.yml.
# Copy to deploy/.env to override. Never commit deploy/.env or real secrets.
POSTGRES_DB=alinha
POSTGRES_USER=alinha
POSTGRES_PASSWORD=alinha
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Used by the app when it runs outside Docker.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/alinha
DB_URL=jdbc:postgresql://localhost:5432/alinha
DB_USER=alinha
DB_PASSWORD=alinha
