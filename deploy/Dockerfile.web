# syntax=docker/dockerfile:1.7
# Frontend shell (with every plugin frontend) behind Nginx. Build from the repo root, with the submodules checked out:
#   docker build -f deploy/Dockerfile.web -t alinha/web .
# The build has no environment-specific values: the same image serves any host.
FROM node:22-slim AS build
RUN npm install -g --ignore-scripts pnpm@10.34.9
WORKDIR /src
# Dependencies from the lockfile alone, in their own layer: a source change does not download them again
# (CI's layer cache is the GitHub Actions cache, which does not keep the --mount caches).
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch
COPY . .
# Frozen, like CI: a plugin pointer update that changes dependencies must update pnpm-lock.yaml too.
RUN pnpm install --offline --frozen-lockfile \
 && pnpm build

# Unprivileged variant: Nginx runs as the nginx user (uid 101), with its pid and caches where that user can write.
# It still listens on 80: Docker lets containers bind ports below 1024 without root (ip_unprivileged_port_start=0).
FROM nginxinc/nginx-unprivileged:1.27-alpine
LABEL org.opencontainers.image.source="https://github.com/PEI-aLinha/alinha"
COPY deploy/nginx/alinha.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/proxy-headers.conf deploy/nginx/security-headers.conf deploy/nginx/spa-headers.conf \
     deploy/nginx/keycloak-proxy.conf /etc/nginx/snippets/
COPY --from=build /src/frontend/shell/dist /usr/share/nginx/html
# The address range of the proxy in front, whose X-Forwarded-For is trusted (overridden in compose).
ENV TRUSTED_PROXY_CIDR=127.0.0.1/32
USER nginx
