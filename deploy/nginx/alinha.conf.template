# Nginx of the web image (deploy/Dockerfile.web). The nginx image runs envsubst on this template at startup;
# only variables set in the environment are replaced, so $host and friends stay as they are.
#
#   /          the shell (SPA)
#   /api/ /oauth2/ /login/oauth2/ /auth/   the BFF (session cookie, OIDC login, token relay to the app)
#   /kc/       Keycloak (login pages, OIDC endpoints); the admin console is not public
server {
    listen 80;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Only the proxy in front may say who the client is. Its X-Forwarded-For becomes $remote_addr, and the
    # upstreams get just that address, so a client cannot pick the IP the BFF's rate limiter sees.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;

    # Docker DNS, re-resolved: Nginx starts even when an upstream is down, and follows a recreated container.
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 20m;

    include /etc/nginx/snippets/security-headers.conf;

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location / {
        try_files $uri /index.html;
    }

    # Vite puts a content hash in every file name under /assets.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location ^~ /api/ {
        set $bff http://bff:8081;
        proxy_pass $bff;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location ^~ /oauth2/ {
        set $bff http://bff:8081;
        proxy_pass $bff;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location ^~ /login/oauth2/ {
        set $bff http://bff:8081;
        proxy_pass $bff;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location ^~ /auth/ {
        set $bff http://bff:8081;
        proxy_pass $bff;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    location ^~ /kc/admin {
        return 404;
    }

    location ^~ /kc/ {
        set $keycloak http://keycloak:8080;
        proxy_pass $keycloak;
        include /etc/nginx/snippets/proxy-headers.conf;
        # Keycloak's login responses carry large cookies and headers.
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
