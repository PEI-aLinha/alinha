{
  "name": "alinha",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:plugins": "node scripts/gen-frontend-plugins.mjs",
    "gen:api": "pnpm --filter @alinha/api-client gen:api",
    "check:api": "pnpm gen:api && git diff --exit-code -- frontend/packages/api-client/src/schema.generated.ts",
    "dev": "pnpm gen:plugins && pnpm --filter @alinha/shell dev",
    "build": "pnpm gen:plugins && pnpm --filter @alinha/shell build",
    "typecheck": "pnpm gen:plugins && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "pnpm gen:plugins && node --test \"scripts/*.test.mjs\" \"eslint-rules/*.test.js\" && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
