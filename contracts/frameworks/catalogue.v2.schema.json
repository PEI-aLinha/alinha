{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alinha.pt/contracts/frameworks/catalogue.v2.schema.json",
  "title": "Framework catalogue v2",
  "description": "Format of frameworks/<framework>/v<n>/catalogue.yaml. Loaded at runtime by the Compliance Engine. Field names and values in English; user-facing text in Portuguese. v2 adds the framework's own level scale (ADR 0007); v1 catalogues have the QNRCS compliance levels.",
  "type": "object",
  "required": [
    "framework",
    "version",
    "title",
    "sources",
    "levels",
    "requirements",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "framework": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Framework id, equal to its folder name, e.g. nis2-qnrcs"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Catalogue version, equal to the vN folder"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Laws, regulations or standards this catalogue is based on"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/level"
      },
      "description": "The framework's ordered level scale, lowest first. Ids are unique; controls point at one of them. Levels are compared by position and never across frameworks."
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "evidenceStrength": {
      "enum": ["SELF_REPORTED", "DOCUMENT_VERIFIED", "TECHNICALLY_VERIFIED", "CONTINUOUSLY_VERIFIED"],
      "description": "How far evidence can be trusted, weakest first (#26)."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+([.-][A-Za-z0-9]+)*$",
      "description": "Stable id. Never reused or changed once published."
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "reference",
        "text",
        "controls"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "description": "Article or measure, e.g. DL 125/2025, art. 27.º"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Ids of the canonical controls that satisfy this requirement"
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "id",
        "title",
        "level",
        "technical",
        "evidence",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Id of a level in this catalogue's levels: the lowest level that requires this control"
        },
        "technical": {
          "type": "boolean",
          "description": "true = can be assigned to an analyst"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence expected for this control"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text",
        "explanation",
        "example",
        "answers"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "description": "Plain-language explanation (FR09)"
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "description": "Concrete example (FR09)"
        },
        "answers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "yes",
              "partial",
              "no",
              "unknown"
            ]
          }
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable level id, e.g. substantial or 3"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Name shown to the user, in Portuguese, e.g. Substancial or Definido"
        },
        "requiredStrength": {
          "$ref": "#/$defs/evidenceStrength",
          "description": "Optional. The weakest evidence that lets a control of this level be met (#26). Default SELF_REPORTED (the answers)."
        },
        "requiredStrengthTechnical": {
          "$ref": "#/$defs/evidenceStrength",
          "description": "Optional. The same for a technical control; never weaker than requiredStrength. Default: requiredStrength."
        }
      }
    }
  }
}
