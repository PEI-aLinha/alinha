{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alinha.pt/contracts/jobs/evidence-collect.v1.schema.json",
  "title": "evidence.collect v1",
  "description": "Job sent by the Job Dispatcher (Kotlin) to a Provider's worker (Python) via Redis Streams. Incompatible changes = new v2 file.",
  "type": "object",
  "required": [
    "jobId",
    "type",
    "tenantId",
    "provider",
    "connectionRef",
    "requestedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "evidence.collect"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "type": "string",
      "description": "provider plugin id, e.g. code-repository"
    },
    "connectionRef": {
      "type": "string",
      "description": "reference to the secret in OpenBao — never the credential itself"
    },
    "scope": {
      "type": "object",
      "description": "provider-specific parameters (e.g. list of repositories)"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
